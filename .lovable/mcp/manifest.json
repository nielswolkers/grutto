{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://uuxsanahnootzrctnlvh.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "grutto",
      "version": "0.1.0",
      "title": "Grutto"
    },
    "tools": [
      {
        "name": "list_subjects",
        "title": "List subjects",
        "description": "List the signed-in user's school subjects (vakken) with their ids, emoji and colour.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_study_sets",
        "title": "List study sets",
        "description": "List the signed-in user's study sets (studiesets), optionally filtered by subject id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "subject_id": {
              "type": "string",
              "format": "uuid",
              "description": "Only return sets linked to this subject."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum number of sets (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_study_set",
        "title": "Get study set",
        "description": "Get one study set with all of its flashcards (term/definition pairs).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "set_id": {
              "type": "string",
              "format": "uuid",
              "description": "The study set id."
            }
          },
          "required": [
            "set_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_study_set",
        "title": "Create study set",
        "description": "Create a study set for the signed-in user, optionally with flashcards and a linked subject.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Title of the study set."
            },
            "description": {
              "type": "string"
            },
            "emoji": {
              "type": "string",
              "maxLength": 8,
              "description": "Cover emoji."
            },
            "subject_id": {
              "type": "string",
              "format": "uuid",
              "description": "Subject (vak) to link the set to."
            },
            "cards": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "term": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "term",
                  "definition"
                ],
                "additionalProperties": false
              },
              "maxItems": 500,
              "description": "Flashcards to add, in order."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_study_cards",
        "title": "Add study cards",
        "description": "Append flashcards (term/definition pairs) to an existing study set owned by the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "set_id": {
              "type": "string",
              "format": "uuid",
              "description": "The study set to add cards to."
            },
            "cards": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "term": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "term",
                  "definition"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 500
            }
          },
          "required": [
            "set_id",
            "cards"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List the signed-in user's tasks (taken), optionally filtered by completion state and due-date range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "completed": {
              "type": "boolean",
              "description": "Filter on completion state; omit for all tasks."
            },
            "due_from": {
              "type": "string",
              "description": "Earliest due date, YYYY-MM-DD."
            },
            "due_to": {
              "type": "string",
              "description": "Latest due date, YYYY-MM-DD."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Create a task (taak) for the signed-in user with a due date and optional time and priority.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "due_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Due date, YYYY-MM-DD."
            },
            "due_time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$",
              "description": "Due time, HH:MM."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "description": "Priority, default medium."
            }
          },
          "required": [
            "title",
            "due_date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "complete_task",
        "title": "Complete or reopen task",
        "description": "Mark one of the signed-in user's tasks as completed, or reopen it.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "format": "uuid"
            },
            "completed": {
              "type": "boolean",
              "description": "True to complete (default), false to reopen."
            }
          },
          "required": [
            "task_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_calendar_events",
        "title": "List agenda events",
        "description": "List the signed-in user's agenda events within an optional date/time range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "ISO timestamp or date; only events starting at or after this moment."
            },
            "to": {
              "type": "string",
              "description": "ISO timestamp or date; only events starting at or before this moment."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_calendar_event",
        "title": "Create agenda event",
        "description": "Create an agenda event (afspraak) for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "start_time": {
              "type": "string",
              "description": "ISO 8601 start timestamp."
            },
            "end_time": {
              "type": "string",
              "description": "ISO 8601 end timestamp."
            },
            "description": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "all_day": {
              "type": "boolean"
            },
            "event_type": {
              "type": "string",
              "description": "Event type label, e.g. afspraak or toets."
            }
          },
          "required": [
            "title",
            "start_time",
            "end_time"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_notes",
        "title": "List notes",
        "description": "List the signed-in user's notes (notities), optionally filtered by folder or search text.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "folder_name": {
              "type": "string",
              "description": "Only notes in this folder."
            },
            "search": {
              "type": "string",
              "description": "Case-insensitive match on the note title."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_note",
        "title": "Create note",
        "description": "Create a note (notitie) for the signed-in user, optionally inside a folder.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string"
            },
            "folder_name": {
              "type": "string"
            },
            "is_pinned": {
              "type": "boolean"
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
